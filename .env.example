# =====================================================================
# DCA Tracker — Environment Variables
# =====================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ---------------------------------------------------------------------
# Market Data Provider
# ---------------------------------------------------------------------
# Provider to use: "alpha_vantage" | "mock"
# Use "mock" for development without an API key (shows demo data).
MARKET_DATA_PROVIDER=mock

# Alpha Vantage API key
# Free tier: https://www.alphavantage.co/support/#api-key
# 25 requests/day on free plan — enough for demo use.
# For production, consider a paid plan or switch provider.
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------
# Cache configuration
# ---------------------------------------------------------------------
# How long to cache market data in seconds (default: 5 minutes)
MARKET_DATA_CACHE_TTL=300

# ---------------------------------------------------------------------
# TODO (premium): Add additional provider keys here
# FINANCIAL_MODELING_PREP_KEY=
# TWELVE_DATA_KEY=
# POLYGON_IO_KEY=
# ---------------------------------------------------------------------

# Site URL — used for canonical tags and Open Graph
# Development: http://localhost:3000
# Production (Vercel env var): https://dcatracker.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# DCA Tracker — Environment Variables
# =====================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Site URL — used for canonical tags, Open Graph, and Stripe redirects
# Development: http://localhost:3000
# Production (Vercel env var): https://dcatracker.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Clerk — Authentication
# https://dashboard.clerk.com → Create Application → API Keys
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk custom sign-in / sign-up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------------------------------------------------------------------
# Stripe — Payments & Subscriptions
# https://dashboard.stripe.com → Developers → API Keys
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret (obtenu lors de la création du webhook dans le dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — créer dans Stripe Dashboard → Products
# Premium mensuel (ex: 4,90 €/mois)
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
# Premium annuel (ex: 39 €/an)
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...
# Pro mensuel (ex: 9,90 €/mois)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# Pro annuel (ex: 79 €/an)
STRIPE_PRO_YEARLY_PRICE_ID=price_...

# ---------------------------------------------------------------------
# Resend — Emails transactionnels
# https://resend.com → API Keys
# ---------------------------------------------------------------------
RESEND_API_KEY=re_...
# Domaine d'envoi vérifié dans Resend (ex: bonjour@dcatracker.fr)
# Utiliser onboarding@resend.dev si le domaine n'est pas encore vérifié
RESEND_FROM_EMAIL=DCA Tracker <bonjour@dcatracker.fr>

# ---------------------------------------------------------------------
# Market Data Provider
# ---------------------------------------------------------------------
# Provider à utiliser : "yahoo_finance" (défaut) | "alpha_vantage" | "mock"
#
# - yahoo_finance : gratuit, sans clé, couvre tous les ETF du catalogue
#   via la lib yahoo-finance2 (scrape API web non-officielle, fragile en
#   théorie). Recommandé pour le développement et le démarrage.
# - alpha_vantage : 25 requêtes/jour free tier — limité, conservé en
#   plan B
# - mock : données illustratives, utile uniquement en CI sans réseau
MARKET_DATA_PROVIDER=yahoo_finance

# Clé Alpha Vantage — non requise en mode yahoo_finance
ALPHA_VANTAGE_API_KEY=

# TTL du cache des cours en secondes (défaut 60 min = 3600s)
# Pour DCA long-terme, aucun intérêt à descendre sous 30 min.
MARKET_DATA_CACHE_TTL=3600

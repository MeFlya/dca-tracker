# =====================================================================
# DCA Tracker — Environment Variables
# =====================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Site URL — used for canonical tags, Open Graph, and Stripe redirects
# Development: http://localhost:3000
# Production (Vercel env var): https://dcatracker.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Clerk — Authentication
# https://dashboard.clerk.com → Create Application → API Keys
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk custom sign-in / sign-up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------------------------------------------------------------------
# Stripe — Payments & Subscriptions
# https://dashboard.stripe.com → Developers → API Keys
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret (obtenu lors de la création du webhook dans le dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — créer dans Stripe Dashboard → Products
# Premium mensuel (ex: 4,90 €/mois)
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
# Premium annuel (ex: 39 €/an)
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...
# Pro mensuel (ex: 9,90 €/mois)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# Pro annuel (ex: 79 €/an)
STRIPE_PRO_YEARLY_PRICE_ID=price_...

# ---------------------------------------------------------------------
# Resend — Emails transactionnels
# https://resend.com → API Keys
# ---------------------------------------------------------------------
RESEND_API_KEY=re_...
# Domaine d'envoi vérifié dans Resend (ex: bonjour@dcatracker.fr)
# Utiliser onboarding@resend.dev si le domaine n'est pas encore vérifié
RESEND_FROM_EMAIL=DCA Tracker <bonjour@dcatracker.fr>

# ---------------------------------------------------------------------
# Cours de bourse : plus aucun (30/10/2026)
# ---------------------------------------------------------------------
# Le site n'affiche plus de cours : comparateur et page « Données de
# marché » depuis le 14/10/2026, fiches ETF depuis le 30/10/2026 (CGU de
# Yahoo Finance : ni usage commercial, ni collecte automatique).
# src/lib/market-data et la dépendance yahoo-finance2 sont supprimés ;
# MARKET_DATA_PROVIDER, ALPHA_VANTAGE_API_KEY et MARKET_DATA_CACHE_TTL ne
# sont plus lues. On peut les retirer des variables Vercel.

# ---------------------------------------------------------------------
# Produits digitaux (paiement unique) — /produits
# ---------------------------------------------------------------------
# Price IDs Stripe (mode payment) — tant qu'ils sont absents, les pages
# produits affichent « Bientôt disponible » (rien ne casse).
# ⚠️ N'activer STRIPE_PRODUCT_BUNDLE_PRICE_ID que lorsque les .enc des
#    DEUX produits existent dans private-assets/ (sinon lien guide mort).
STRIPE_PRODUCT_TEMPLATE_PRICE_ID=price_...
STRIPE_PRODUCT_GUIDE_PRICE_ID=price_...
STRIPE_PRODUCT_BUNDLE_PRICE_ID=price_...

# Signe les liens de téléchargement (HMAC) ET dérive la clé AES des fichiers
# .enc commités (repo public). ⚠️ MÊME VALEUR en local et sur Vercel — un
# mismatch rend les fichiers indéchiffrables en prod (503 pour l'acheteur).
# Rotation = relancer `npm run assets:encrypt` + committer les .enc + redéployer.
DOWNLOAD_TOKEN_SECRET=

# Lien « créer une copie » du Google Sheets du Cockpit DCA. S'il est absent,
# le livrable Google Sheets est SILENCIEUSEMENT omis de l'email et de la
# page merci — à configurer en prod AVANT d'activer le price ID du Cockpit.
GOOGLE_SHEETS_TEMPLATE_COPY_URL=
